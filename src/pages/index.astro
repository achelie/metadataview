---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetadataReportWorkbench from '../components/MetadataReportWorkbench';
import { IconGlyph } from '../components/IconGlyph';
import { canonicalUrl } from '../lib/seo';
import { metadataViewerFaqs } from '../content/metadata-faqs';

const title = 'Metadata Viewer — Inspect Files Without Uploading';
const description = 'View metadata in JPEG, PNG, WebP, PDF, MP4, and MP3 files directly in your browser. Search fields and export a complete local report.';
const homeUrl = canonicalUrl('/', Astro.site);
const faqs = [...metadataViewerFaqs];
const schemas = [
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${homeUrl}#website`, name: 'MetadataView', url: homeUrl, description, inLanguage: 'en' },
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', '@id': `${homeUrl}#metadata-viewer`, name: 'Metadata Viewer', applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any modern browser', url: homeUrl, description, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, featureList: ['Read six common file formats', 'Search native metadata fields', 'Export JSON and PDF reports', 'Process files locally in the browser'] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
];
const formatLinks = [
  { href: '/image-metadata-viewer/', label: 'Images', formats: 'JPEG · PNG · WebP', detail: 'EXIF, GPS, XMP, IPTC, ICC, and PNG text' },
  { href: '/pdf-metadata-viewer/', label: 'Documents', formats: 'PDF', detail: 'Author, dates, producer, pages, and custom fields' },
  { href: '/video-metadata-viewer/', label: 'Video', formats: 'MP4', detail: 'Duration, dimensions, codecs, tracks, and dates' },
  { href: '/audio-metadata-viewer/', label: 'Audio', formats: 'MP3', detail: 'ID3 tags, duration, bitrate, and cover presence' },
];
const nextTools = [
  { href: '/image-privacy-checker/', icon: 'shield' as const, label: 'Check image privacy', note: 'Find GPS, names, device IDs, thumbnails, and editing traces.' },
  { href: '/metadata-remover/', icon: 'eraser' as const, label: 'Remove image metadata', note: 'Create a cleaned copy, rescan it, and download the verification receipt.' },
  { href: '/c2pa-viewer/', icon: 'badge' as const, label: 'Verify C2PA credentials', note: 'Check signed provenance with the official browser verifier.' },
];
---
<BaseLayout title={title} description={description} path="/" schemas={schemas}>
  <div class="home-shell home-tool-first">
    <section class="home-tool-intro" aria-labelledby="home-title">
      <div class="home-intro-rail"><span>LOCAL / NO UPLOAD</span><i></i></div>
      <div><span class="eyebrow">Free metadata viewer</span><h1 id="home-title">View file metadata in your browser</h1><p>Drop a JPEG, PNG, WebP, PDF, MP4, or MP3. Your file stays on this device.</p></div>
      <aside><strong>100 MB</strong><span>one-file limit</span></aside>
    </section>

    <MetadataReportWorkbench client:load placement="home" scope="all" formats="JPEG · PNG · WebP · PDF · MP4 · MP3" accept=".jpg,.jpeg,.png,.webp,.pdf,.mp4,.mp3" allowedTypes={['jpeg','png','webp','pdf','mp4','mp3']} />

    <nav class="home-format-links" aria-label="Metadata viewers by file format">
      <span class="section-index">BROWSE BY FORMAT</span>
      {formatLinks.map((item) => <a href={item.href}><span>{item.label}</span><strong>{item.formats}</strong><small>{item.detail}</small><i aria-hidden="true"><IconGlyph name="arrow" size={16} /></i></a>)}
    </nav>

    <section class="home-next-tools" aria-labelledby="next-tools-title">
      <header><span class="section-index">NEED A DIFFERENT JOB?</span><h2 id="next-tools-title">Use the right tool next.</h2><p>The metadata report stays general. These tools answer one specific question.</p></header>
      <div>{nextTools.map((tool) => <a href={tool.href}><span class="home-tool-icon"><IconGlyph name={tool.icon} size={25} /></span><h3>{tool.label}</h3><p>{tool.note}</p><small>Open tool</small></a>)}</div>
    </section>

    <section class="home-local-note" aria-labelledby="local-title">
      <div><span class="section-index">LOCAL BY DESIGN</span><h2 id="local-title">The file never takes a network trip.</h2></div>
      <dl><div><dt>Upload route</dt><dd>None</dd></div><div><dt>File history</dt><dd>None</dd></div><div><dt>Refresh</dt><dd>Forgets the report</dd></div></dl>
      <p>A local Worker reads the bytes in this tab. ExifTool loads from this site only after you choose a file. <a class="inline-link" href="/privacy/">Read the privacy details</a></p>
    </section>

    <section class="home-faq expanded-faq" aria-labelledby="home-faq-title"><div class="expanded-faq-inner"><h2 id="home-faq-title">Frequently asked questions</h2><div class="expanded-faq-list">{faqs.map((faq) => <article><h3>{faq.question}</h3><p>{faq.answer}</p></article>)}</div></div></section>
  </div>
</BaseLayout>
