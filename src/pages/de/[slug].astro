---
import ToolLayout from '../../layouts/ToolLayout.astro';
import ContentPage from '../../components/pages/ContentPage.astro';
import { getTool, toolSlugs, type ToolKey } from '../../content/tools-i18n';

type ContentKey = 'about' | 'privacy' | 'contact' | 'terms';
type PageProps = { kind: 'tool'; key: ToolKey } | { kind: 'content'; key: ContentKey };

export function getStaticPaths() {
  const toolPaths = Object.entries(toolSlugs).map(([slug, key]) => ({ params: { slug }, props: { kind: 'tool', key } satisfies PageProps }));
  const contentPaths = (['about', 'privacy', 'contact', 'terms'] satisfies ContentKey[]).map((key) => ({ params: { slug: key }, props: { kind: 'content', key } as PageProps }));
  return [...toolPaths, ...contentPaths];
}

const page = Astro.props as PageProps;
const tool = page.kind === 'tool' ? getTool(page.key, 'de') : undefined;
---
{page.kind === 'tool' && tool ? <ToolLayout {...tool} locale="de" /> : page.kind === 'content' ? <ContentPage kind={page.key} locale="de" /> : null}
