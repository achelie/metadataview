import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 – This Metadata Field Is Missing" description="The requested page could not be found." path="/404/" noindex={true}>
  <section class="not-found"><span>ERROR / 404</span><h1>This field<br />came back <em>undefined.</em></h1><p>The page is missing. Unlike suspicious metadata, it is probably not hiding somewhere useful.</p><div class="button-row"><a class="button button-primary" href="/">Back to the toolkit</a><a class="button button-secondary" href="/metadata-viewer/">Inspect a real file</a></div></section>
</BaseLayout>
