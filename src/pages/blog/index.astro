---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import BlogToolStrip from '../../components/BlogToolStrip.astro';
import ReadingRoutes from '../../components/ReadingRoutes.astro';
import { blogPagePath, paginateBlogPosts, sortBlogPosts, validateBlogRelationships } from '../../lib/blog';
import '../../styles/blog.css';

const posts = sortBlogPosts(await getCollection('blog'));
validateBlogRelationships(posts);
const { featured, pages, pageCount } = paginateBlogPosts(posts);
const latest = pages[0] ?? [];
const title = 'Metadata Privacy Guides | ViewExif';
const description = 'Plain-English guides to image metadata, EXIF privacy, file provenance, and making cleaner copies before you share.';
const pageUrl = new URL('/blog/', Astro.site).toString();
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'ViewExif',
    description,
    url: pageUrl,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: posts.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: post.data.title,
        url: new URL(`/blog/${post.id}/`, Astro.site).toString(),
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: pageUrl },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  path="/blog/"
  schemas={schemas}
  image={featured ? { src: featured.data.cover.src, alt: featured.data.coverAlt, width: 1600, height: 900 } : undefined}
>
  <div class="blog-index page-shell">
    <ReadingRoutes />
    {featured && (
      <section class="blog-feature" aria-labelledby="featured-guide-title">
        <div class="blog-section-heading"><span>Featured guide</span><p>Start here</p></div>
        <div id="featured-guide-title"><BlogPostCard post={featured} featured /></div>
      </section>
    )}

    {latest.length > 0 && (
      <section class="blog-latest" aria-labelledby="latest-posts-title">
        <div class="blog-section-heading"><h2 id="latest-posts-title">Latest posts</h2><p>Page 1 of {pageCount}</p></div>
        <div class="blog-latest__grid">{latest.map((post) => <BlogPostCard post={post} />)}</div>
        {pageCount > 1 && (
          <nav class="blog-pagination" aria-label="Blog pages">
            {Array.from({ length: pageCount }, (_, index) => index + 1).map((number) => number === 1
              ? <span aria-current="page">1</span>
              : <a href={blogPagePath(number)} aria-label={`Go to blog page ${number}`}>{number}</a>)}
          </nav>
        )}
      </section>
    )}

    <BlogToolStrip />
  </div>
</BaseLayout>
