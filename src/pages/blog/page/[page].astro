---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogPostCard from '../../../components/BlogPostCard.astro';
import BlogToolStrip from '../../../components/BlogToolStrip.astro';
import { BLOG_PAGE_SIZE, blogPagePath, paginateBlogPosts, sortBlogPosts, validateBlogRelationships } from '../../../lib/blog';
import '../../../styles/blog.css';

export async function getStaticPaths() {
  const posts = sortBlogPosts(await getCollection('blog'));
  validateBlogRelationships(posts);
  const { pages, pageCount } = paginateBlogPosts(posts);
  return pages.slice(1).map((pagePosts, index) => ({
    params: { page: String(index + 2) },
    props: { posts: pagePosts, page: index + 2, pageCount },
  }));
}

const { posts, page, pageCount } = Astro.props;
const path = `/blog/page/${page}/`;
const description = `MetadataView guides about metadata privacy and file provenance, page ${page}.`;
const pageUrl = new URL(path, Astro.site).toString();
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `MetadataView Blog, page ${page}`,
    description,
    url: pageUrl,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: posts.map((post, index) => ({
        '@type': 'ListItem',
        position: (page - 1) * BLOG_PAGE_SIZE + index + 1,
        name: post.data.title,
        url: new URL(`/blog/${post.id}/`, Astro.site).toString(),
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: `Page ${page}`, item: pageUrl },
    ],
  },
];
---
<BaseLayout title={`Metadata Privacy Guides — Page ${page} | MetadataView`} description={description} path={path} schemas={schemas}>
  <div class="blog-index blog-index--paged page-shell">
    <header class="blog-index__header"><div><span class="blog-kicker">MetadataView field notes</span><h1>Latest metadata guides.</h1></div><p>Page {page} of {pageCount}. Practical explanations, no mystery-meat security claims.</p></header>
    <section class="blog-latest" aria-labelledby="latest-posts-title">
      <div class="blog-section-heading"><h2 id="latest-posts-title">Latest posts</h2><a href="/blog/">Back to featured guide</a></div>
      <div class="blog-latest__grid">{posts.map((post) => <BlogPostCard post={post} />)}</div>
      <nav class="blog-pagination" aria-label="Blog pages">
        {Array.from({ length: pageCount }, (_, index) => index + 1).map((number) => number === page ? <span aria-current="page">{number}</span> : <a href={blogPagePath(number)} aria-label={`Go to blog page ${number}`}>{number}</a>)}
      </nav>
    </section>
    <BlogToolStrip />
  </div>
</BaseLayout>
