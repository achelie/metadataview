---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { guideHubs } from '../../lib/guide-hubs';
import sharingCover from '../../assets/blog/guide-sharing-metadata.webp';
import fileTypesCover from '../../assets/blog/guide-metadata-by-file-type.webp';

export function getStaticPaths() {
  return guideHubs.map((hub) => ({ params: { slug: hub.slug }, props: { hub } }));
}
const { hub } = Astro.props;
const cover = hub.slug === 'sharing-metadata'
  ? { image: sharingCover, alt: 'A person using a smartphone to send a message' }
  : { image: fileTypesCover, alt: 'A camera, lenses, graphics tablet and laptop on a desk' };
const posts = await getCollection('blog');
const postIds = new Set(posts.map((post) => post.id));
for (const group of hub.groups) {
  for (const link of group.links) {
    const match = link.href.match(/^\/blog\/([^/]+)\/$/);
    if (match && !postIds.has(match[1]!)) throw new Error(`Missing guide article: ${link.href}`);
  }
}
const path = `/guides/${hub.slug}/`;
const pageUrl = new URL(path, Astro.site).toString();
const links = hub.groups.flatMap((group) => group.links);
const schemas = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: hub.title, description: hub.description, url: pageUrl, image: new URL(cover.image.src, Astro.site).toString(), mainEntity: { '@type': 'ItemList', itemListElement: links.map((link, index) => ({ '@type': 'ListItem', position: index + 1, name: link.label, url: new URL(link.href, Astro.site).toString() })) } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [ { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() }, { '@type': 'ListItem', position: 2, name: hub.title, item: pageUrl } ] },
];
---
<BaseLayout title={`${hub.title} | ViewExif`} description={hub.description} path={path} schemas={schemas} image={{ src: cover.image.src, alt: cover.alt, width: cover.image.width, height: cover.image.height }}>
  <div class="guide-hub page-shell">
    <header class="guide-intro">
      <a class="back-link" href="/blog/">← All guides</a>
      <h1>{hub.title}</h1>
      <p>{hub.intro}</p>
    </header>
    <figure class="guide-cover">
      <img src={cover.image.src} alt={cover.alt} width={cover.image.width} height={cover.image.height} loading="eager" decoding="async" />
    </figure>
    {hub.groups.map((group) => (
      <section class="guide-section">
        <div class="group-intro"><h2>{group.title}</h2><p>{group.intro}</p></div>
        <ul>{group.links.map((link) => <li><a href={link.href}><strong>{link.label}</strong><span>{link.note}</span></a></li>)}</ul>
      </section>
    ))}
    <aside class="guide-next"><h2>{hub.next.title}</h2><p>{hub.next.text}</p><a href={hub.next.href}>{hub.next.label} →</a></aside>
  </div>
</BaseLayout>
<style>
  .guide-hub { padding-block: var(--section-space); }
  .guide-intro { padding-bottom: var(--section-space); border-bottom: 1px solid var(--ink); }
  .back-link { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; text-underline-offset: .2em; }
  h1 { margin: .5rem 0; }
  p { max-width: var(--prose-width); line-height: 1.6; margin: 0; }
  .guide-cover { max-width: 1100px; margin: var(--layout-gap) auto 0; }
  .guide-cover img { display: block; width: 100%; aspect-ratio: 1.9 / 1; object-fit: cover; border: 1px solid var(--line); border-radius: .34rem; }
  .guide-section { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: var(--layout-gap); padding-block: var(--section-space); border-bottom: 1px solid var(--line); }
  h2 { margin: 0 0 .6rem; }
  .group-intro, ul, li { min-width: 0; }
  ul { padding: 0; margin: 0; list-style: none; }
  li + li { border-top: 1px solid var(--line); }
  li a { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); gap: .5rem 1rem; align-items: baseline; min-height: 44px; padding: .7rem 0; }
  li a strong, .guide-next a { text-decoration: underline; text-underline-offset: .2em; }
  li a:hover strong, .guide-next a:hover { color: var(--rust); }
  li span { color: var(--ink-soft); line-height: 1.5; }
  .guide-next { padding-top: var(--section-space); }
  .guide-next a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; }
  @media (max-width: 680px) { .guide-section { grid-template-columns: minmax(0, 1fr); } li a { grid-template-columns: minmax(0, 1fr); gap: .15rem; } }
</style>
