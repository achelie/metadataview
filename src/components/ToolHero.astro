---
import type { IconName } from './IconGlyph';
import { IconGlyph } from './IconGlyph';
import type { Locale } from '../i18n/core';
interface Props { eyebrow: string; title: string; description: string; icon: IconName; formats: string; proof?: string; locale?: Locale }
const { eyebrow, title, description, icon, formats, proof, locale = 'en' } = Astro.props;
const supported = locale === 'zh-CN' ? '支持格式' : locale === 'de' ? 'Unterstützt' : locale === 'fr' ? 'Formats' : 'Supported';
---
<section class="tool-hero" aria-labelledby="tool-title">
  <span class="tool-hero-icon" aria-hidden="true"><IconGlyph name={icon} size={28} /></span>
  <div class="tool-hero-copy"><span class="eyebrow">{eyebrow}</span><h1 id="tool-title">{title}</h1><p>{description}</p>{proof ? <small class="tool-hero-proof">{proof}</small> : null}</div>
  <div class="format-strip"><span>{supported}</span><strong>{formats}</strong></div>
</section>
