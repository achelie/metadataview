---
import type { Locale } from '../i18n/core';
const { locale = 'en' } = Astro.props as { locale?: Locale };
const copy = {
  en: { title: 'Choose a guide for your question', note: 'Explore these English guides for practical answers and the decisions behind the tools.', links: ['What happens to metadata when I share?', 'How do I check or clean this file type?', 'Read stored GPS', 'Separate capture time from file dates', 'Check what a screenshot carries', 'Remove private fields before sharing'] },
  de: { title: 'Wähle eine Anleitung für deine Frage', note: 'Diese Anleitungen sind auf Englisch und helfen bei Fragen zu Dateien und Werkzeugen.', links: ['Was passiert beim Teilen mit Metadaten?', 'Wie prüfe oder bereinige ich diesen Dateityp?', 'Gespeicherte GPS-Daten lesen', 'Aufnahmezeit von Dateidaten unterscheiden', 'Metadaten eines Screenshots verstehen', 'Private Felder vor dem Teilen entfernen'] },
  fr: { title: 'Choisissez un guide selon votre question', note: 'Ces guides en anglais répondent aux questions sur les fichiers et les outils.', links: ['Que deviennent les métadonnées lors du partage ?', 'Comment vérifier ou nettoyer ce type de fichier ?', 'Lire les coordonnées GPS enregistrées', 'Distinguer prise de vue et dates du fichier', 'Comprendre les métadonnées des captures', 'Retirer les champs privés avant le partage'] },
  'zh-CN': { title: '按问题选指南', note: '以下指南为英文，帮你理解文件信息和工具中的选择。', links: ['分享后元数据会怎样？', '如何检查或清理这种文件？', '读取照片里保存的 GPS', '区分拍摄时间与文件日期', '检查截图可能携带的信息', '分享前清理私人字段'] },
}[locale];
const paths = ['/guides/sharing-metadata/', '/guides/metadata-by-file-type/', '/blog/how-to-find-where-a-photo-was-taken/', '/blog/how-to-tell-when-a-photo-was-taken/', '/blog/do-screenshots-have-metadata/', '/blog/how-to-remove-gps-data-from-photos-before-sharing/'];
---
<nav class="reading-routes" aria-label={copy.title}>
  <div><h2>{copy.title}</h2><p>{copy.note}</p></div>
  <ul>{paths.map((path, i) => <li><a href={path} hreflang="en">{copy.links[i]}</a></li>)}</ul>
</nav>
<style>
  .reading-routes { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--layout-gap); margin: var(--section-space) 0; padding: var(--layout-gap) 0; border-block: 1px solid currentColor; }
  :global(.blog-index) > .reading-routes { margin-block: 0; padding-top: 0; border-top: 0; }
  h2 { font-size: var(--text-card); margin: 0 0 .75rem; }
  p { line-height: 1.65; margin: 0; }
  ul { margin: 0; padding-left: 1.25rem; }
  li { margin: 0; }
  a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; text-underline-offset: .2em; overflow-wrap: anywhere; }
  @media (max-width: 640px) { .reading-routes { grid-template-columns: minmax(0, 1fr); gap: 1rem; } }
</style>
