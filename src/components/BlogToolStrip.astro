---
interface Props {
  category?: string;
}

type ToolScope = 'image' | 'document' | 'audio' | 'video' | 'all';
const scopesByCategory: Record<string, ToolScope> = {
  'Image privacy': 'image',
  'EXIF basics': 'image',
  'Metadata basics': 'image',
  'GPS metadata': 'image',
  'Document metadata': 'document',
  'Document privacy': 'document',
  'Audio privacy': 'audio',
  'Video privacy': 'video',
  'Metadata management': 'all',
};
const category = Astro.props.category;
const scope = (category && Object.hasOwn(scopesByCategory, category) ? scopesByCategory[category] : undefined) ?? 'all';
const prefix = scope === 'all' ? '' : `${scope}-`;
const links = [
  { href: `/${prefix}metadata-viewer/`, label: `View ${scope === 'all' ? 'file' : scope} metadata` },
  ...(scope === 'image' ? [{ href: '/image-privacy-checker/', label: 'Check image privacy' }] : []),
  { href: `/${prefix}metadata-remover/`, label: 'Make a cleaner copy' },
];
---
<aside class="blog-tool-strip" aria-labelledby="blog-tool-strip-title">
  <div>
    <span class="blog-kicker">No theory required</span>
    <h2 id="blog-tool-strip-title">Check the file you actually plan to share.</h2>
  </div>
  <nav aria-label="Recommended metadata tools">
    {links.map((link, index) => <a href={link.href}><strong>{String(index + 1).padStart(2, '0')}</strong><span>{link.label}</span></a>)}
  </nav>
</aside>
