---
import type { BlogPost } from '../lib/blog';
import { blogPath, formatBlogDate, getReadingTime } from '../lib/blog';

interface Props {
  post: BlogPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const minutes = getReadingTime(post.body ?? '');
---
<article class:list={['blog-post-card', featured && 'blog-post-card--featured']}>
  <a class="blog-post-card__media" href={blogPath(post)} aria-label={`Read ${post.data.title}`}>
    <img src={post.data.cover.src} alt={post.data.coverAlt} width={post.data.cover.width} height={post.data.cover.height} loading={featured ? 'eager' : 'lazy'} decoding="async" />
  </a>
  <div class="blog-post-card__copy">
    <div class="blog-post-card__meta">
      <span>{post.data.category}</span>
      <time datetime={post.data.publishedAt.toISOString()}>{formatBlogDate(post.data.publishedAt)}</time>
      <span>{minutes} min read</span>
    </div>
    <h2><a href={blogPath(post)}>{post.data.title}</a></h2>
    <p>{post.data.excerpt}</p>
    <a class="blog-read-link" href={blogPath(post)}>Read the guide <span aria-hidden="true">→</span></a>
  </div>
</article>
