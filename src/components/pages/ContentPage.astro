    intro: `${SITE_BRAND} wird unabhängig von einer Einzelperson betrieben. Produkt-, Datenschutz-, Redaktions- und Technikfragen erreichen dieselbe Person.`,
    emailLabel: 'ÖFFENTLICHER KONTAKT', emailTitle: 'E-Mail senden', emailText: `Nutze ${SITE_CONTACT_EMAIL} für Datenschutzfragen, Korrekturen, Fehlerberichte, Rechtefragen oder eine klare Beschreibung eines überraschenden Ergebnisses.`, emailButton: `E-Mail an ${SITE_CONTACT_EMAIL}`,
    beforeLabel: 'VOR DEM ABSENDEN', beforeTitle: 'Sende das Nützliche. Behalte Privates für dich.',
    beforeItems: ['Nenne Seiten-URL und Browser-Version.', 'Beschreibe Dateiformat und Feldnamen, nicht den privaten Feldwert.', 'Sende bei einem Layoutproblem einen geschwärzten Screenshot. Hänge keine private Originaldatei an.'],
    noFormTitle: 'Warum es kein Kontaktformular gibt', noFormText: 'Diese Seite sendet nichts an einen ViewExif-Server. Der E-Mail-Link öffnet dein Mailprogramm. Dein Anbieter und der Anbieter des empfangenden Postfachs verarbeiten die Nachricht nach ihren eigenen Bedingungen.',
    linksLabel: 'REGELN UND HINTERGRUND', linksTitle: 'Lies die Details vor dem Schreiben', about: 'Wer ViewExif betreibt', privacy: 'Wie Daten behandelt werden', terms: 'Regeln für die Werkzeuge',
  },
  fr: {
    title: 'Contacter ViewExif — Joindre l’exploitant indépendant', description: 'Contactez l’exploitant indépendant de ViewExif par e-mail. Aucun formulaire, compte ou base de formulaires côté serveur.',
