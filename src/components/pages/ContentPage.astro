---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizePath, type Locale } from '../../i18n/core';
import { POLICY_EFFECTIVE_DATE, SITE_BRAND, SITE_CONTACT_EMAIL } from '../../config/site';

type ContentPageKind = 'about' | 'privacy' | 'contact' | 'terms';
interface Props { locale?: Locale; kind: ContentPageKind }
interface ContentLink { label: string; href: string }
interface LinkedParagraph { text: string; links?: ContentLink[] }
interface LegalSection { id: string; label: string; title: string; paragraphs: LinkedParagraph[] }
interface LegalCopy {
  title: string; description: string; eyebrow: string; heading: string; intro: string;
  navLabel: string; effectiveLabel: string; operatorNote: string; sections: LegalSection[];
}

const { locale = 'en', kind } = Astro.props;
const path = localizePath(`/${kind}/`, locale);
const contactHref = `mailto:${SITE_CONTACT_EMAIL}`;
const GOOGLE_PARTNER_SITES = 'https://policies.google.com/technologies/partner-sites';
const GOOGLE_AD_SETTINGS = 'https://adssettings.google.com/';
const AHREFS_PRIVACY = 'https://ahrefs.com/privacy-policy';
const CLOUDFLARE_PRIVACY = 'https://www.cloudflare.com/privacypolicy/';
const p = (text: string, links: ContentLink[] = []): LinkedParagraph => ({ text, links });
const s = (id: string, label: string, title: string, ...paragraphs: LinkedParagraph[]): LegalSection => ({ id, label, title, paragraphs });
const link = (label: string, href: string): ContentLink => ({ label, href });

const aboutCopy = {
  en: {
    title: 'About ViewExif — Who Builds and Checks This Toolkit',
    description: 'Who operates ViewExif, how its browser-only metadata tools are built, and who is responsible for the guides and technical checks.',
    eyebrow: 'Who is behind the toolkit', heading: 'One operator. No mystery company.',
    intro: `${SITE_BRAND} is a brand independently operated by an individual. The same operator builds and maintains the tools, writes and updates the guides, and performs the technical checks described on this site.`,
    principles: [
      ['Local first', 'If a modern browser can do the job safely, your file should not take a detour through somebody else’s server.'],
      ['Show the evidence', 'A privacy score without reasons is just a mood. Results point to the fields found and the next practical step.'],
      ['Say where it stops', 'Metadata can be edited. Credentials have a limited scope. Visible pixels can still reveal private details. We say that plainly.'],
    ],
    operatorLabel: 'RESPONSIBILITY, IN PLAIN SIGHT', operatorTitle: 'Built, written, and checked by the independent operator',
    operatorText: `${SITE_BRAND} does not claim to be a company, public institution, camera maker, social platform, Google product, Adobe product, or C2PA authority. Product decisions, editorial updates, and technical verification remain the responsibility of its individual operator.`,
    toolkit: 'THE TOOLKIT', toolsTitle: 'Working paths, not decorative mockups',
    toolsText: 'The viewer, privacy checker, metadata removers, and C2PA verifier run as real browser tools. Guides explain common sharing risks and are reviewed against the behavior of the current implementation.',
    inspect: 'Inspect a file', clean: 'Clean a copy', contact: 'Contact the operator', privacy: 'Read the privacy policy', terms: 'Read the terms',
  },
  de: {
    title: 'Über ViewExif – Wer diesen Werkzeugkasten baut und prüft',
    description: 'Wer ViewExif betreibt, wie die lokalen Metadaten-Werkzeuge entstehen und wer für Anleitungen und technische Prüfungen verantwortlich ist.',
    eyebrow: 'Wer hinter den Werkzeugen steht', heading: 'Eine Person. Keine erfundene Firma.',
    intro: `${SITE_BRAND} ist eine Marke, die unabhängig von einer Einzelperson betrieben wird. Dieselbe Person entwickelt und pflegt die Werkzeuge, schreibt und aktualisiert die Anleitungen und führt die auf dieser Website beschriebenen technischen Prüfungen durch.`,
    principles: [
      ['Lokal zuerst', 'Was ein moderner Browser sicher erledigen kann, muss keinen Umweg über fremde Server nehmen.'],
      ['Belege statt Bauchgefühl', 'Ein Datenschutzwert ohne Gründe ist nur Stimmung. Ergebnisse zeigen die gefundenen Felder und einen praktischen nächsten Schritt.'],
