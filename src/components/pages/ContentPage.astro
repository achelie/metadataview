    toolkit: '工具箱', toolsTitle: '能真正走通的流程，不是装饰用的效果图',
    toolsText: '查看器、隐私检查、元数据清理和 C2PA 验证都是能在浏览器里实际运行的工具。指南会解释常见分享风险，并按照当前版本的真实行为做技术核验。',
    inspect: '检查一个文件', clean: '清理一个副本', contact: '联系运营者', privacy: '查看隐私说明', terms: '查看使用条款',
  },
} as const;

const contactCopy = {
  en: {
    title: 'Contact ViewExif — Reach the Independent Operator', description: 'Contact the independent operator of ViewExif by email. No contact form, account, or server-side form database is used.',
    eyebrow: 'A real route to the operator', heading: 'Email, minus the mystery form.',
    intro: `${SITE_BRAND} is independently operated by an individual. Product, privacy, editorial, and technical questions all reach the same operator.`,
    emailLabel: 'PUBLIC CONTACT', emailTitle: 'Send an email', emailText: `Use ${SITE_CONTACT_EMAIL} for privacy questions, correction requests, bug reports, rights concerns, or a clear explanation of a surprising result.`, emailButton: `Email ${SITE_CONTACT_EMAIL}`,
    beforeLabel: 'BEFORE YOU HIT SEND', beforeTitle: 'Give the useful bits. Keep the private bits.',
    beforeItems: ['Include the page URL and browser version.', 'Describe the file format and the field name, not the private field value.', 'Send a redacted screenshot if the layout matters. Do not attach the original private file.'],
    noFormTitle: 'Why there is no contact form', noFormText: 'This page does not submit anything to a ViewExif server. Clicking the email link opens your mail app. Your email provider and the receiving mailbox provider will process the message under their own terms.',
    linksLabel: 'POLICIES AND CONTEXT', linksTitle: 'Check the details before writing', about: 'Who operates ViewExif', privacy: 'How data is handled', terms: 'Rules for using the tools',
  },
  de: {
    title: 'Kontakt zu ViewExif – Den unabhängigen Betreiber erreichen', description: 'Kontaktiere den unabhängigen Betreiber von ViewExif per E-Mail. Kein Formular, kein Konto und keine Formulardatenbank auf dem Server.',
