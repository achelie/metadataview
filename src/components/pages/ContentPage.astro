---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizePath, type Locale } from '../../i18n/core';

interface Props { locale?: Locale; kind: 'about' | 'privacy' }
const { locale = 'en', kind } = Astro.props;
const path = localizePath(`/${kind}/`, locale);

const aboutCopy = {
  en: {
    title: 'About ViewExif — A Local Metadata Privacy Toolkit', description: 'Why ViewExif exists, what its browser-only tools do, and where this open MVP draws the line.', eyebrow: 'About the toolkit', heading: 'Files talk. This site translates.', intro: 'A photo can carry GPS. A document can name its author. An audio file can reveal credits and encoding history. ViewExif makes those details visible before you share the file.',
    principles: [['Local first', 'If a modern browser can do the job safely, the file should not take a detour through somebody else’s server.'], ['Explain the verdict', 'A privacy score without reasons is just a mood. Every risk points to fields and a next action.'], ['Admit the edge', 'Metadata is editable. Credentials have scope. Pixels can leak details. The copy says that out loud.']],
    toolkit: 'THE TOOLKIT', toolsTitle: 'Four complete paths, not four mockups', toolsText: 'The universal viewer handles 28 file formats across images, documents, video, and audio. Image privacy rules score hidden exposure. Five matching remover routes create and verify content-preserving copies. The C2PA page dynamically loads the official browser verifier.', inspect: 'Inspect a file', clean: 'Clean a copy',
  },
  de: {
    title: 'Über ViewExif – Lokale Werkzeuge für Metadaten und Datenschutz', description: 'Warum ViewExif existiert, was die reinen Browser-Tools leisten und wo dieses offene Produkt bewusst Grenzen zieht.', eyebrow: 'Über den Werkzeugkasten', heading: 'Dateien reden. Diese Website übersetzt.', intro: 'Ein Foto kann GPS-Daten tragen. Ein Dokument kann seinen Autor nennen. Eine Audiodatei verrät Credits und Codierungsverlauf. ViewExif legt diese Details offen, bevor du die Datei teilst.',
    principles: [['Lokal zuerst', 'Was ein moderner Browser sicher erledigen kann, muss keinen Umweg über fremde Server nehmen.'], ['Das Ergebnis erklären', 'Ein Datenschutzwert ohne Gründe ist nur Stimmung. Jedes Risiko verweist auf konkrete Felder und einen nächsten Schritt.'], ['Grenzen offen benennen', 'Metadaten sind editierbar. Credentials haben einen begrenzten Aussagebereich. Auch Pixel können Privates verraten. Das sagen wir deutlich.']],
    toolkit: 'DER WERKZEUGKASTEN', toolsTitle: 'Vier vollständige Wege, keine vier Attrappen', toolsText: 'Der universelle Viewer verarbeitet 28 Bild-, Dokument-, Video- und Audioformate. Datenschutzregeln bewerten versteckte Risiken. Fünf passende Entferner erzeugen inhaltstreue Kopien und prüfen sie erneut. Die C2PA-Seite lädt den offiziellen Browser-Verifier nur bei Bedarf.', inspect: 'Datei prüfen', clean: 'Kopie bereinigen',
  },
  'zh-CN': {
    title: '关于 ViewExif — 本地元数据隐私工具箱', description: '了解 ViewExif 为什么存在、这些只在浏览器运行的工具能做什么，以及它坦白承认的能力边界。', eyebrow: '关于这套工具', heading: '文件会说话。这里负责翻译。', intro: '照片可能带着 GPS，文档可能写着作者，音频也会留下署名和编码历史。ViewExif 在你分享文件前，把这些藏起来的细节摆到桌面上。',
    principles: [['本地优先', '现代浏览器能安全完成的事，就没必要让文件绕路去别人家的服务器。'], ['把结论说明白', '不讲原因的隐私分数只是情绪。每项风险都要指向具体字段，再告诉你下一步能做什么。'], ['边界也摆出来', '元数据能改，凭证也有适用范围，画面本身更可能泄密。这里不会装作看不见。']],
    toolkit: '工具箱', toolsTitle: '四条能走通的完整流程，不是四张效果图', toolsText: '通用查看器支持图片、文档、视频和音频共 28 种格式；图片隐私规则会给隐藏风险打分；五个清理入口会生成副本并再次验证；C2PA 页面则按需加载官方浏览器验证器。', inspect: '检查一个文件', clean: '清理一个副本',
  },
} as const;

const privacyCopy = {
  en: {
    title: 'Privacy – Your Files Never Leave Your Device', description: 'How ViewExif keeps file inspection private with local browser processing, short-lived memory, no upload endpoint, and no file-content analytics.', eyebrow: 'Plain-English privacy', heading: 'The server never meets your file.', intro: 'ViewExif is a static browser tool. You select a file; JavaScript in this tab reads it. There is no account, upload route, cloud bucket, or file history.', nav: ['Processing', 'Memory', 'Analytics', 'Cookies', 'Limits'],
    sections: [['How files are processed', 'Supported files are read from browser memory. Parsing runs in a Web Worker when practical. Image cleanup uses browser image decoding and Canvas re-encoding. C2PA verification loads the official WebAssembly library only on its tool page.', 'No selected file or extracted metadata is sent to a ViewExif server.'], ['What stays in memory', 'The selected file and result live only in the current page session. We do not put them in localStorage, a URL, IndexedDB, or a cookie. Refresh or close the tab and that state disappears.', 'Temporary Object URLs created for downloads are revoked after use. Workers terminate when a task finishes or the page unmounts.'], ['Analytics', 'We use Ahrefs Web Analytics to understand aggregate page traffic. The analytics script does not receive uploaded files, file bytes, metadata values, prompts, filenames, or local paths.', ''], ['Cookies and future ads', 'The MVP does not require an account or first-party session cookie. Future third-party advertising may use its own cookies under its own policy, but browser isolation does not grant an ad script access to the file input or parsed result.', ''], ['The honest limit', 'Local processing protects the transfer path. It does not make the visible content anonymous, prove metadata is true, or detect malicious files. Do not open files you do not trust merely because the parser is local.', '']],
  },
  de: {
    title: 'Datenschutz – Deine Dateien verlassen dein Gerät nicht', description: 'So hält ViewExif Dateiinspektionen privat: lokale Browser-Verarbeitung, kurzlebiger Speicher, kein Upload-Endpunkt und keine Analyse von Dateiinhalten.', eyebrow: 'Datenschutz ohne Juristendeutsch', heading: 'Der Server lernt deine Datei nie kennen.', intro: 'ViewExif ist ein statisches Browser-Tool. Du wählst eine Datei, JavaScript in diesem Tab liest sie. Es gibt kein Konto, keine Upload-Route, keinen Cloud-Speicher und keinen Dateiverlauf.', nav: ['Verarbeitung', 'Speicher', 'Analyse', 'Cookies', 'Grenzen'],
    sections: [['Wie Dateien verarbeitet werden', 'Unterstützte Dateien werden aus dem Browserspeicher gelesen. Wenn sinnvoll, läuft der Parser in einem Web Worker. Die Bildbereinigung nutzt Browser-Decoding und Canvas-Neucodierung. Für C2PA wird die offizielle WebAssembly-Bibliothek nur auf der passenden Tool-Seite geladen.', 'Weder die ausgewählte Datei noch extrahierte Metadaten werden an einen ViewExif-Server gesendet.'], ['Was im Speicher bleibt', 'Datei und Ergebnis existieren nur in der aktuellen Seitensitzung. Wir speichern sie nicht in localStorage, URL, IndexedDB oder Cookies. Beim Neuladen oder Schließen des Tabs verschwindet der Zustand.', 'Temporäre Object URLs für Downloads werden danach widerrufen. Worker enden, wenn der Vorgang abgeschlossen oder die Seite verlassen wird.'], ['Webanalyse', 'Wir verwenden Ahrefs Web Analytics für zusammengefasste Seitenaufrufe. Das Skript erhält keine Dateien, Datei-Bytes, Metadatenwerte, Dateinamen oder lokalen Pfade.', ''], ['Cookies und mögliche künftige Werbung', 'Die aktuelle Version braucht weder Konto noch eigenen Sitzungs-Cookie. Künftige Drittanbieterwerbung kann nach ihrer eigenen Richtlinie Cookies nutzen; die Browser-Isolation gewährt Werbeskripten jedoch keinen Zugriff auf Dateiauswahl oder Parsergebnis.', ''], ['Die ehrliche Grenze', 'Lokale Verarbeitung schützt den Übertragungsweg. Sie anonymisiert sichtbare Inhalte nicht automatisch, beweist keine Metadaten und erkennt keine schädlichen Dateien. Öffne keine Datei, der du nicht vertraust, nur weil der Parser lokal läuft.', '']],
  },
  'zh-CN': {
    title: '隐私说明 — 文件不会离开你的设备', description: 'ViewExif 通过浏览器本地处理、短期内存、不设上传接口，也不分析文件内容，尽量把文件检查留在你的设备上。', eyebrow: '说人话的隐私说明', heading: '服务器根本见不到你的文件。', intro: 'ViewExif 是静态浏览器工具。你选择文件，当前标签页里的 JavaScript 负责读取。没有账号、上传接口、云存储桶，也没有文件历史。', nav: ['处理方式', '内存', '流量统计', 'Cookies', '能力边界'],
    sections: [['文件怎么处理', '支持的文件从浏览器内存读取，合适时会交给 Web Worker 解析。图片清理使用浏览器解码和 Canvas 重新编码；C2PA 只在对应工具页按需加载官方 WebAssembly 库。', '你选择的文件和提取出的元数据都不会发送到 ViewExif 服务器。'], ['内存里会留下什么', '文件和结果只存在于当前页面会话。我们不会把它们放进 localStorage、URL、IndexedDB 或 Cookie。刷新或关闭标签页，状态就没了。', '下载用的临时 Object URL 会在使用后撤销。任务完成或页面卸载时，Worker 也会终止。'], ['流量统计', '我们使用 Ahrefs Web Analytics 了解汇总后的页面流量。统计脚本不会收到文件、文件字节、元数据值、文件名或本地路径。', ''], ['Cookie 与未来的广告', '当前版本不需要账号或第一方会话 Cookie。未来的第三方广告可能依据自己的政策使用 Cookie，但浏览器隔离不会让广告脚本碰到文件输入框或解析结果。', ''], ['老实说，边界在这里', '本地处理保护的是传输路径。它不会自动匿名化画面、证明元数据为真，也不能识别恶意文件。别因为解析器在本地，就随手打开不可信的文件。', '']],
  },
} as const;

const about = aboutCopy[locale];
const privacy = privacyCopy[locale];
const meta = kind === 'about' ? about : privacy;
const sectionIds = ['processing', 'memory', 'analytics', 'cookies', 'limits'];
---
<BaseLayout title={meta.title} description={meta.description} path={path} locale={locale} translated>
  {kind === 'about' ? <article class="content-page">
    <header><span class="eyebrow">{about.eyebrow}</span><h1>{about.heading}</h1><p>{about.intro}</p></header>
    <div class="manifesto">{about.principles.map((item, index) => <div><span>{String(index + 1).padStart(2, '0')}</span><h2>{item[0]}</h2><p>{item[1]}</p></div>)}</div>
    <section class="about-tools"><span class="section-index">{about.toolkit}</span><h2>{about.toolsTitle}</h2><p>{about.toolsText}</p><div class="button-row"><a class="button button-primary" href={localizePath('/metadata-viewer/', locale)}>{about.inspect}</a><a class="button button-secondary" href={localizePath('/metadata-remover/', locale)}>{about.clean}</a></div></section>
  </article> : <article class="content-page">
    <header><span class="eyebrow">{privacy.eyebrow}</span><h1>{privacy.heading}</h1><p>{privacy.intro}</p></header>
    <div class="content-grid"><nav>{privacy.nav.map((label, index) => <a href={`#${sectionIds[index]}`}>{label}</a>)}</nav><div>{privacy.sections.map((section, index) => <section id={sectionIds[index]}><span class="section-index">{String(index + 1).padStart(2, '0')}</span><h2>{section[0]}</h2><p>{section[1]}</p>{section[2] && <p>{section[2]}</p>}</section>)}</div></div>
  </article>}
</BaseLayout>
