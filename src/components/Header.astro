---
import StaticIcon from './StaticIcon.astro';
import { localizePath, stripLocale, type Locale } from '../i18n/core';
import { getMessages } from '../i18n/messages';

const pathname = Astro.url.pathname;
interface Props { locale?: Locale; translated?: boolean }
const { locale = 'en', translated = false } = Astro.props;
const copy = getMessages(locale);
const basePath = stripLocale(pathname);
const hrefFor = (href: string) => localizePath(href, locale);
const viewItems = [
  { href: '/', label: copy.allFormats },
  { href: '/image-metadata-viewer/', label: copy.images },
  { href: '/video-metadata-viewer/', label: copy.videos },
  { href: '/audio-metadata-viewer/', label: copy.audio },
  { href: '/document-metadata-viewer/', label: copy.documents },
];
const removeItems: Array<{ href: string; label: string }> = [
  { href: '/metadata-remover/', label: copy.allFormats },
  { href: '/image-metadata-remover/', label: copy.images },
  { href: '/video-metadata-remover/', label: copy.videos },
  { href: '/audio-metadata-remover/', label: copy.audio },
  { href: '/document-metadata-remover/', label: copy.documents },
];
const isCurrent = (href: string) => basePath === href;
const viewCurrent = basePath === '/' || basePath === '/metadata-viewer/' || basePath === '/image-metadata-viewer/' || basePath === '/video-metadata-viewer/' || basePath === '/audio-metadata-viewer/' || basePath === '/document-metadata-viewer/';
const removeCurrent = removeItems.some((item) => basePath === item.href);
const isViewItemCurrent = (item: (typeof viewItems)[number]) => item.href === '/' && basePath === '/';
const languageOptions: Array<{ locale: Locale; label: string; short: string }> = [
  { locale: 'en', label: 'English', short: 'EN' },
  { locale: 'de', label: 'Deutsch', short: 'DE' },
  { locale: 'fr', label: 'Français', short: 'FR' },
  { locale: 'zh-CN', label: '中文', short: '中文' },
];
const currentLanguage = languageOptions.find((item) => item.locale === locale) ?? languageOptions[0]!;
const languageHref = (target: Locale) => translated ? localizePath(basePath, target) : target === 'en' ? basePath : localizePath('/', target);
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={hrefFor('/')} aria-label={`ViewExif ${copy.home}`}>
      <span class="brand-mark"><i></i><i></i><i></i></span>
      <span>ViewExif</span>
    </a>
    <nav class="desktop-nav" aria-label={copy.mainNavigation}>
      <div class="nav-dropdown" data-nav-dropdown data-open="false">
        <button class:list={['nav-dropdown-trigger', { 'is-current': viewCurrent }]} type="button" aria-expanded="false">{copy.viewMetadata} <span class="nav-dropdown-chevron"><StaticIcon name="chevronDown" size={15} /></span></button>
        <div class="nav-dropdown-panel t-dropdown" data-origin="top-left" aria-label={copy.viewMetadata} aria-hidden="true" inert>
          {viewItems.map((item) => <a href={hrefFor(item.href)} aria-current={isViewItemCurrent(item) ? 'page' : undefined}>{item.label}</a>)}
        </div>
      </div>
      <a href={hrefFor('/image-privacy-checker/')} aria-current={isCurrent('/image-privacy-checker/') ? 'page' : undefined}>{copy.checkPrivacy}</a>
      <div class="nav-dropdown" data-nav-dropdown data-open="false">
        <button class:list={['nav-dropdown-trigger', { 'is-current': removeCurrent }]} type="button" aria-expanded="false">{copy.removeMetadata} <span class="nav-dropdown-chevron"><StaticIcon name="chevronDown" size={15} /></span></button>
        <div class="nav-dropdown-panel t-dropdown" data-origin="top-left" aria-label={copy.removeMetadata} aria-hidden="true" inert>
          {removeItems.map((item) => <a href={hrefFor(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </div>
      </div>
      <a href={hrefFor('/c2pa-viewer/')} aria-current={isCurrent('/c2pa-viewer/') ? 'page' : undefined}>{copy.verifyC2pa}</a>
      <a href="/blog/" aria-current={basePath.startsWith('/blog/') ? 'page' : undefined}>{copy.blog}</a>
    </nav>
    <div class="nav-dropdown language-dropdown" data-nav-dropdown data-open="false">
      <button class="nav-dropdown-trigger language-ticket" type="button" aria-expanded="false" aria-label={`${copy.language}: ${currentLanguage.label}`}>
        <StaticIcon name="languages" size={15} /><span>{currentLanguage.short}</span><span class="nav-dropdown-chevron"><StaticIcon name="chevronDown" size={14} /></span>
      </button>
      <div class="nav-dropdown-panel language-dropdown-panel t-dropdown" data-origin="top-right" aria-label={copy.language} aria-hidden="true" inert>
        {languageOptions.map((item) => <a href={languageHref(item.locale)} hreflang={item.locale} lang={item.locale} aria-current={locale === item.locale ? 'page' : undefined}><span>{item.label}</span><small>{item.short}</small></a>)}
      </div>
    </div>
    <a class="header-cta" href={hrefFor('/')} aria-current={isCurrent('/') ? 'page' : undefined}>{copy.viewMetadata} <StaticIcon name="arrow" size={16} /></a>
    <button class="mobile-menu-trigger" type="button" aria-label={copy.openNavigation} aria-expanded="false" aria-controls="mobile-navigation-drawer" data-mobile-menu-trigger data-open-label={copy.openNavigation} data-close-label={copy.closeNavigation}>
      <span class="t-icon-swap" data-state="a" aria-hidden="true">
        <span class="t-icon" data-icon="a"><StaticIcon name="menu" size={25} /></span>
        <span class="t-icon" data-icon="b"><StaticIcon name="close" size={25} /></span>
      </span>
    </button>
  </div>
</header>

<div class="mobile-menu-layer" data-mobile-menu-layer data-open="false" aria-hidden="true" inert>
  <button class="mobile-menu-backdrop" type="button" tabindex="-1" aria-label={copy.closeNavigation} data-mobile-menu-backdrop></button>
  <div class="mobile-menu-rail">
    <nav id="mobile-navigation-drawer" class="mobile-menu-drawer t-panel-slide" data-open="false" aria-label={copy.mobileNavigation}>
      <h2>{copy.navigation}</h2>
      <div class="nav-dropdown language-dropdown mobile-language-dropdown" data-nav-dropdown data-open="false">
        <button class="nav-dropdown-trigger" type="button" aria-expanded="false">
          <span><StaticIcon name="languages" size={17} /> {copy.language}</span><strong>{currentLanguage.label}</strong><span class="nav-dropdown-chevron"><StaticIcon name="chevronDown" size={16} /></span>
        </button>
        <div class="nav-dropdown-panel language-dropdown-panel t-dropdown" data-origin="top-right" aria-label={copy.language} aria-hidden="true" inert>
          {languageOptions.map((item) => <a href={languageHref(item.locale)} hreflang={item.locale} lang={item.locale} aria-current={locale === item.locale ? 'page' : undefined}><span>{item.label}</span><small>{item.short}</small></a>)}
        </div>
      </div>
      <div class="mobile-nav-list">
        <div class="mobile-nav-group t-acc" data-mobile-accordion data-open="false">
          <button class="t-acc-head" type="button" aria-expanded="false">{copy.viewMetadata} <span class="t-acc-chevron"><StaticIcon name="chevronDown" size={17} /></span></button>
          <div class="t-acc-panel" aria-hidden="true" inert><div class="t-acc-panel-inner"><div>{viewItems.map((item) => <a href={hrefFor(item.href)} aria-current={isViewItemCurrent(item) ? 'page' : undefined}>{item.label}</a>)}</div></div></div>
        </div>
        <a class="mobile-nav-link" href={hrefFor('/image-privacy-checker/')} aria-current={isCurrent('/image-privacy-checker/') ? 'page' : undefined}>{copy.checkPrivacy}</a>
        <div class="mobile-nav-group t-acc" data-mobile-accordion data-open="false">
          <button class="t-acc-head" type="button" aria-expanded="false">{copy.removeMetadata} <span class="t-acc-chevron"><StaticIcon name="chevronDown" size={17} /></span></button>
          <div class="t-acc-panel" aria-hidden="true" inert><div class="t-acc-panel-inner"><div>{removeItems.map((item) => <a href={hrefFor(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}</div></div></div>
        </div>
        <a class="mobile-nav-link" href={hrefFor('/c2pa-viewer/')} aria-current={isCurrent('/c2pa-viewer/') ? 'page' : undefined}>{copy.verifyC2pa}</a>
        <a class="mobile-nav-link" href="/blog/" aria-current={basePath.startsWith('/blog/') ? 'page' : undefined}>{copy.blog}</a>
      </div>
    </nav>
  </div>
</div>

<script>
  const dropdowns = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-dropdown]'));
  const dropdownCloseMs = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--dropdown-close-dur')) || 150;
  const dropdownTimers = new WeakMap<HTMLElement, number>();
  const mobileTrigger = document.querySelector<HTMLButtonElement>('[data-mobile-menu-trigger]');
  const mobileLayer = document.querySelector<HTMLElement>('[data-mobile-menu-layer]');
  const mobileDrawer = document.querySelector<HTMLElement>('#mobile-navigation-drawer');
  const mobileBackdrop = document.querySelector<HTMLButtonElement>('[data-mobile-menu-backdrop]');
  const mobileAccordions = Array.from(document.querySelectorAll<HTMLElement>('[data-mobile-accordion]'));

  function closeDropdown(dropdown: HTMLElement) {
    if (dropdown.dataset.open !== 'true') return;
    const trigger = dropdown.querySelector<HTMLButtonElement>('.nav-dropdown-trigger');
    const panel = dropdown.querySelector<HTMLElement>('.t-dropdown');
    const timer = dropdownTimers.get(dropdown);
    if (timer) window.clearTimeout(timer);
    dropdown.dataset.open = 'false';
    trigger?.setAttribute('aria-expanded', 'false');
    panel?.setAttribute('aria-hidden', 'true');
    if (panel) panel.inert = true;
    panel?.classList.remove('is-open');
    panel?.classList.add('is-closing');
    dropdownTimers.set(dropdown, window.setTimeout(() => panel?.classList.remove('is-closing'), dropdownCloseMs));
  }

  function openDropdown(dropdown: HTMLElement) {
    for (const other of dropdowns) if (other !== dropdown) closeDropdown(other);
    const trigger = dropdown.querySelector<HTMLButtonElement>('.nav-dropdown-trigger');
    const panel = dropdown.querySelector<HTMLElement>('.t-dropdown');
    const timer = dropdownTimers.get(dropdown);
    if (timer) window.clearTimeout(timer);
    panel?.classList.remove('is-closing');
    panel?.classList.add('is-open');
    panel?.setAttribute('aria-hidden', 'false');
    if (panel) panel.inert = false;
    trigger?.setAttribute('aria-expanded', 'true');
    dropdown.dataset.open = 'true';
  }

  for (const dropdown of dropdowns) dropdown.querySelector<HTMLButtonElement>('.nav-dropdown-trigger')?.addEventListener('click', () => dropdown.dataset.open === 'true' ? closeDropdown(dropdown) : openDropdown(dropdown));

  function setMobileOpen(open: boolean, restoreFocus = true) {
    if (!mobileLayer || !mobileDrawer || !mobileTrigger) return;
    mobileLayer.dataset.open = String(open);
    mobileDrawer.dataset.open = String(open);
    mobileLayer.setAttribute('aria-hidden', String(!open));
    mobileLayer.inert = !open;
    mobileTrigger.setAttribute('aria-expanded', String(open));
    mobileTrigger.setAttribute('aria-label', open ? mobileTrigger.dataset.closeLabel || 'Close navigation' : mobileTrigger.dataset.openLabel || 'Open navigation');
    mobileTrigger.querySelector<HTMLElement>('.t-icon-swap')?.setAttribute('data-state', open ? 'b' : 'a');
    document.body.classList.toggle('nav-drawer-open', open);
    if (open) window.setTimeout(() => mobileDrawer.querySelector<HTMLButtonElement>('.mobile-language-dropdown .nav-dropdown-trigger')?.focus(), 50);
    else {
      for (const dropdown of dropdowns) if (mobileDrawer.contains(dropdown)) closeDropdown(dropdown);
      if (restoreFocus) mobileTrigger.focus();
    }
  }

  mobileTrigger?.addEventListener('click', () => setMobileOpen(mobileTrigger.getAttribute('aria-expanded') !== 'true'));
  mobileBackdrop?.addEventListener('click', () => setMobileOpen(false));

  for (const accordion of mobileAccordions) {
    const head = accordion.querySelector<HTMLButtonElement>('.t-acc-head');
    head?.addEventListener('click', () => {
      const open = accordion.dataset.open === 'true';
      for (const other of mobileAccordions) {
        if (other === accordion) continue;
        other.dataset.open = 'false';
        other.querySelector<HTMLButtonElement>('.t-acc-head')?.setAttribute('aria-expanded', 'false');
        const otherPanel = other.querySelector<HTMLElement>('.t-acc-panel');
        otherPanel?.setAttribute('aria-hidden', 'true');
        if (otherPanel) otherPanel.inert = true;
      }
      accordion.dataset.open = String(!open);
      head.setAttribute('aria-expanded', String(!open));
      const panel = accordion.querySelector<HTMLElement>('.t-acc-panel');
      panel?.setAttribute('aria-hidden', String(open));
      if (panel) panel.inert = open;
    });
  }

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    for (const dropdown of dropdowns) if (dropdown.dataset.open === 'true' && !dropdown.contains(event.target)) closeDropdown(dropdown);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      if (mobileTrigger?.getAttribute('aria-expanded') === 'true') {
        setMobileOpen(false);
        return;
      }
      const open = [...dropdowns].reverse().find((dropdown) => dropdown.dataset.open === 'true');
      if (open) {
        closeDropdown(open);
        open.querySelector<HTMLButtonElement>('.nav-dropdown-trigger')?.focus();
      }
      return;
    }
    if (event.key === 'Tab' && mobileTrigger?.getAttribute('aria-expanded') === 'true' && mobileLayer) {
      const focusable = [mobileTrigger, ...Array.from(mobileLayer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'))].filter((element) => (!element.hasAttribute('tabindex') || element.tabIndex >= 0) && !element.closest('[inert]'));
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    }
  });

  window.addEventListener('resize', () => { if (window.innerWidth > 900 && mobileTrigger?.getAttribute('aria-expanded') === 'true') setMobileOpen(false, false); });
</script>
