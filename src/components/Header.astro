---
import StaticIcon from './StaticIcon.astro';

const pathname = Astro.url.pathname;
const viewItems = [
  { href: '/', label: 'All Formats' },
  { href: '/image-metadata-viewer/', label: 'Images' },
  { href: '/video-metadata-viewer/', label: 'Videos' },
  { href: '/audio-metadata-viewer/', label: 'Audio' },
  { href: '/document-metadata-viewer/', label: 'Documents' },
];
const removeItems: Array<{ href: string; label: string }> = [
  { href: '/metadata-remover/', label: 'All Formats' },
  { href: '/image-metadata-remover/', label: 'Images' },
  { href: '/video-metadata-remover/', label: 'Videos' },
  { href: '/audio-metadata-remover/', label: 'Audio' },
  { href: '/document-metadata-remover/', label: 'Documents' },
];
const isCurrent = (href: string) => pathname === href;
const viewCurrent = pathname === '/' || pathname === '/metadata-viewer/' || pathname === '/image-metadata-viewer/' || pathname === '/video-metadata-viewer/' || pathname === '/audio-metadata-viewer/' || pathname === '/document-metadata-viewer/';
const removeCurrent = removeItems.some((item) => pathname === item.href);
const isViewItemCurrent = (item: (typeof viewItems)[number]) => item.label === 'All Formats' && pathname === '/';
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Metadata Privacy Toolkit home">
      <span class="brand-mark"><i></i><i></i><i></i></span>
      <span>Metadata<span>View</span></span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      <div class="nav-dropdown" data-nav-dropdown data-open="false">
        <button class:list={['nav-dropdown-trigger', { 'is-current': viewCurrent }]} type="button" aria-expanded="false">View metadata <span class="nav-dropdown-chevron"><StaticIcon name="chevronDown" size={15} /></span></button>
        <div class="nav-dropdown-panel t-dropdown" data-origin="top-left" aria-label="View metadata by format" aria-hidden="true" inert>
          {viewItems.map((item) => <a href={item.href} aria-current={isViewItemCurrent(item) ? 'page' : undefined}>{item.label}</a>)}
        </div>
      </div>
      <a href="/image-privacy-checker/" aria-current={isCurrent('/image-privacy-checker/') ? 'page' : undefined}>Check privacy</a>
      <div class="nav-dropdown" data-nav-dropdown data-open="false">
        <button class:list={['nav-dropdown-trigger', { 'is-current': removeCurrent }]} type="button" aria-expanded="false">Remove metadata <span class="nav-dropdown-chevron"><StaticIcon name="chevronDown" size={15} /></span></button>
        <div class="nav-dropdown-panel t-dropdown" data-origin="top-left" aria-label="Remove metadata by format" aria-hidden="true" inert>
          {removeItems.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </div>
      </div>
      <a href="/c2pa-viewer/" aria-current={isCurrent('/c2pa-viewer/') ? 'page' : undefined}>Verify C2PA</a>
      <a href="/blog/" aria-current={pathname.startsWith('/blog/') ? 'page' : undefined}>Blog</a>
    </nav>
    <a class="header-cta" href="/" aria-current={isCurrent('/') ? 'page' : undefined}>View metadata <StaticIcon name="arrow" size={16} /></a>
    <button class="mobile-menu-trigger" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-navigation-drawer" data-mobile-menu-trigger>
      <span class="t-icon-swap" data-state="a" aria-hidden="true">
        <span class="t-icon" data-icon="a"><StaticIcon name="menu" size={25} /></span>
        <span class="t-icon" data-icon="b"><StaticIcon name="close" size={25} /></span>
      </span>
    </button>
  </div>
</header>

<div class="mobile-menu-layer" data-mobile-menu-layer data-open="false" aria-hidden="true" inert>
  <button class="mobile-menu-backdrop" type="button" tabindex="-1" aria-label="Close navigation" data-mobile-menu-backdrop></button>
  <div class="mobile-menu-rail">
    <nav id="mobile-navigation-drawer" class="mobile-menu-drawer t-panel-slide" data-open="false" aria-label="Mobile navigation">
      <h2>Navigation</h2>
      <div class="mobile-nav-list">
        <div class="mobile-nav-group t-acc" data-mobile-accordion data-open="false">
          <button class="t-acc-head" type="button" aria-expanded="false">View metadata <span class="t-acc-chevron"><StaticIcon name="chevronDown" size={17} /></span></button>
          <div class="t-acc-panel" aria-hidden="true" inert><div class="t-acc-panel-inner"><div>{viewItems.map((item) => <a href={item.href} aria-current={isViewItemCurrent(item) ? 'page' : undefined}>{item.label}</a>)}</div></div></div>
        </div>
        <a class="mobile-nav-link" href="/image-privacy-checker/" aria-current={isCurrent('/image-privacy-checker/') ? 'page' : undefined}>Check privacy</a>
        <div class="mobile-nav-group t-acc" data-mobile-accordion data-open="false">
          <button class="t-acc-head" type="button" aria-expanded="false">Remove metadata <span class="t-acc-chevron"><StaticIcon name="chevronDown" size={17} /></span></button>
          <div class="t-acc-panel" aria-hidden="true" inert><div class="t-acc-panel-inner"><div>{removeItems.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}</div></div></div>
        </div>
        <a class="mobile-nav-link" href="/c2pa-viewer/" aria-current={isCurrent('/c2pa-viewer/') ? 'page' : undefined}>Verify C2PA</a>
        <a class="mobile-nav-link" href="/blog/" aria-current={pathname.startsWith('/blog/') ? 'page' : undefined}>Blog</a>
      </div>
    </nav>
  </div>
</div>

<script>
  const dropdowns = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-dropdown]'));
  const dropdownCloseMs = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--dropdown-close-dur')) || 150;
  const dropdownTimers = new WeakMap<HTMLElement, number>();
  const mobileTrigger = document.querySelector<HTMLButtonElement>('[data-mobile-menu-trigger]');
  const mobileLayer = document.querySelector<HTMLElement>('[data-mobile-menu-layer]');
  const mobileDrawer = document.querySelector<HTMLElement>('#mobile-navigation-drawer');
  const mobileBackdrop = document.querySelector<HTMLButtonElement>('[data-mobile-menu-backdrop]');
  const mobileAccordions = Array.from(document.querySelectorAll<HTMLElement>('[data-mobile-accordion]'));

  function closeDropdown(dropdown: HTMLElement) {
    if (dropdown.dataset.open !== 'true') return;
    const trigger = dropdown.querySelector<HTMLButtonElement>('.nav-dropdown-trigger');
    const panel = dropdown.querySelector<HTMLElement>('.t-dropdown');
    const timer = dropdownTimers.get(dropdown);
    if (timer) window.clearTimeout(timer);
    dropdown.dataset.open = 'false';
    trigger?.setAttribute('aria-expanded', 'false');
    panel?.setAttribute('aria-hidden', 'true');
    if (panel) panel.inert = true;
    panel?.classList.remove('is-open');
    panel?.classList.add('is-closing');
    dropdownTimers.set(dropdown, window.setTimeout(() => panel?.classList.remove('is-closing'), dropdownCloseMs));
  }

  function openDropdown(dropdown: HTMLElement) {
    for (const other of dropdowns) if (other !== dropdown) closeDropdown(other);
    const trigger = dropdown.querySelector<HTMLButtonElement>('.nav-dropdown-trigger');
    const panel = dropdown.querySelector<HTMLElement>('.t-dropdown');
    const timer = dropdownTimers.get(dropdown);
    if (timer) window.clearTimeout(timer);
    panel?.classList.remove('is-closing');
    panel?.classList.add('is-open');
    panel?.setAttribute('aria-hidden', 'false');
    if (panel) panel.inert = false;
    trigger?.setAttribute('aria-expanded', 'true');
    dropdown.dataset.open = 'true';
  }

  for (const dropdown of dropdowns) dropdown.querySelector<HTMLButtonElement>('.nav-dropdown-trigger')?.addEventListener('click', () => dropdown.dataset.open === 'true' ? closeDropdown(dropdown) : openDropdown(dropdown));

  function setMobileOpen(open: boolean, restoreFocus = true) {
    if (!mobileLayer || !mobileDrawer || !mobileTrigger) return;
    mobileLayer.dataset.open = String(open);
    mobileDrawer.dataset.open = String(open);
    mobileLayer.setAttribute('aria-hidden', String(!open));
    mobileLayer.inert = !open;
    mobileTrigger.setAttribute('aria-expanded', String(open));
    mobileTrigger.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    mobileTrigger.querySelector<HTMLElement>('.t-icon-swap')?.setAttribute('data-state', open ? 'b' : 'a');
    document.body.classList.toggle('nav-drawer-open', open);
    if (open) window.setTimeout(() => mobileAccordions[0]?.querySelector<HTMLButtonElement>('.t-acc-head')?.focus(), 50);
    else if (restoreFocus) mobileTrigger.focus();
  }

  mobileTrigger?.addEventListener('click', () => setMobileOpen(mobileTrigger.getAttribute('aria-expanded') !== 'true'));
  mobileBackdrop?.addEventListener('click', () => setMobileOpen(false));

  for (const accordion of mobileAccordions) {
    const head = accordion.querySelector<HTMLButtonElement>('.t-acc-head');
    head?.addEventListener('click', () => {
      const open = accordion.dataset.open === 'true';
      for (const other of mobileAccordions) {
        if (other === accordion) continue;
        other.dataset.open = 'false';
        other.querySelector<HTMLButtonElement>('.t-acc-head')?.setAttribute('aria-expanded', 'false');
        const otherPanel = other.querySelector<HTMLElement>('.t-acc-panel');
        otherPanel?.setAttribute('aria-hidden', 'true');
        if (otherPanel) otherPanel.inert = true;
      }
      accordion.dataset.open = String(!open);
      head.setAttribute('aria-expanded', String(!open));
      const panel = accordion.querySelector<HTMLElement>('.t-acc-panel');
      panel?.setAttribute('aria-hidden', String(open));
      if (panel) panel.inert = open;
    });
  }

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    for (const dropdown of dropdowns) if (dropdown.dataset.open === 'true' && !dropdown.contains(event.target)) closeDropdown(dropdown);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      if (mobileTrigger?.getAttribute('aria-expanded') === 'true') {
        setMobileOpen(false);
        return;
      }
      const open = [...dropdowns].reverse().find((dropdown) => dropdown.dataset.open === 'true');
      if (open) {
        closeDropdown(open);
        open.querySelector<HTMLButtonElement>('.nav-dropdown-trigger')?.focus();
      }
      return;
    }
    if (event.key === 'Tab' && mobileTrigger?.getAttribute('aria-expanded') === 'true' && mobileLayer) {
      const focusable = [mobileTrigger, ...Array.from(mobileLayer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'))].filter((element) => (!element.hasAttribute('tabindex') || element.tabIndex >= 0) && !element.closest('[inert]'));
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    }
  });

  window.addEventListener('resize', () => { if (window.innerWidth > 900 && mobileTrigger?.getAttribute('aria-expanded') === 'true') setMobileOpen(false, false); });
</script>
