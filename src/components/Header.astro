---
import StaticIcon from './StaticIcon.astro';
import { localizePath, stripLocale, type Locale } from '../i18n/core';
import { getMessages } from '../i18n/messages';

interface Props { locale?: Locale; translated?: boolean }
const { locale = 'en', translated = false } = Astro.props;
const copy = getMessages(locale);
const basePath = stripLocale(Astro.url.pathname);
const hrefFor = (href: string) => localizePath(href, locale);
const viewItems = [
  { href: '/', label: copy.allFormats },
  { href: '/image-metadata-viewer/', label: copy.images },
  { href: '/video-metadata-viewer/', label: copy.videos },
  { href: '/audio-metadata-viewer/', label: copy.audio },
  { href: '/document-metadata-viewer/', label: copy.documents },
];
const removeItems = [
  { href: '/metadata-remover/', label: copy.allFormats },
  { href: '/image-metadata-remover/', label: copy.images },
  { href: '/video-metadata-remover/', label: copy.videos },
  { href: '/audio-metadata-remover/', label: copy.audio },
  { href: '/document-metadata-remover/', label: copy.documents },
];
const isCurrent = (href: string) => basePath === href || (href === '/' && basePath === '/metadata-viewer/');
const toolsCurrent = [...viewItems, ...removeItems, { href: '/image-privacy-checker/' }, { href: '/c2pa-viewer/' }].some((item) => isCurrent(item.href));
const languageOptions: Array<{ locale: Locale; label: string; short: string }> = [
  { locale: 'en', label: 'English', short: 'EN' },
  { locale: 'de', label: 'Deutsch', short: 'DE' },
  { locale: 'fr', label: 'Français', short: 'FR' },
  { locale: 'zh-CN', label: '简体中文', short: '中文' },
];
const currentLanguage = languageOptions.find((item) => item.locale === locale) ?? languageOptions[0]!;
const languageHref = (target: Locale) => translated ? localizePath(basePath, target) : target === 'en' ? basePath : localizePath('/', target);
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={hrefFor('/')} aria-label={`ViewExif ${copy.home}`}>
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>ViewExif</span>
    </a>
    <!-- One navigation tree serves both the desktop bar and the mobile drawer. -->
    <div class="header-nav-shell" data-mobile-menu-layer data-open="false">
      <button class="mobile-menu-backdrop" type="button" tabindex="-1" aria-label={copy.closeNavigation} data-mobile-menu-backdrop></button>
      <nav id="mobile-navigation-drawer" class="desktop-nav mobile-menu-drawer" data-open="false" aria-label={copy.mainNavigation}>
        <div class="mobile-nav-list">
          <div class="nav-dropdown tools-dropdown" data-nav-dropdown data-open="false">
            <button class:list={['nav-dropdown-trigger', { 'is-current': toolsCurrent }]} type="button" aria-expanded="false" aria-controls="header-tools">{copy.tools} <span class="nav-dropdown-chevron"><StaticIcon name="chevronDown" size={15} /></span></button>
            <div id="header-tools" class="nav-dropdown-panel tools-dropdown-panel t-dropdown" data-origin="top-right" aria-hidden="true" hidden inert>
              <section class="nav-tool-section" aria-labelledby="nav-view-heading">
                <h2 id="nav-view-heading">{copy.viewMetadata}</h2>
                {viewItems.map((item) => <a href={hrefFor(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
              </section>
              <section class="nav-tool-section" aria-labelledby="nav-remove-heading">
                <h2 id="nav-remove-heading">{copy.removeMetadata}</h2>
                {removeItems.map((item) => <a href={hrefFor(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
              </section>
              <div class="nav-tool-checks">
                <a href={hrefFor('/image-privacy-checker/')} aria-current={isCurrent('/image-privacy-checker/') ? 'page' : undefined}>{copy.checkPrivacy} <StaticIcon name="arrow" size={16} /></a>
                <a href={hrefFor('/c2pa-viewer/')} aria-current={isCurrent('/c2pa-viewer/') ? 'page' : undefined}>{copy.verifyC2pa} <StaticIcon name="arrow" size={16} /></a>
              </div>
            </div>
          </div>
          <a class="mobile-nav-link" href="/blog/" aria-current={basePath.startsWith('/blog/') ? 'page' : undefined}>{copy.blog}</a>
          <a class="mobile-nav-link" href={hrefFor('/about/')} aria-current={isCurrent('/about/') ? 'page' : undefined}>{copy.about}</a>
        </div>
      </nav>
    </div>
    <div class="nav-dropdown language-dropdown" data-nav-dropdown data-open="false">
      <button class="nav-dropdown-trigger language-ticket" type="button" aria-expanded="false" aria-controls="header-languages" aria-label={`${copy.language}: ${currentLanguage.label}`}>
        <StaticIcon name="languages" size={15} /><span>{currentLanguage.short}</span><span class="nav-dropdown-chevron"><StaticIcon name="chevronDown" size={14} /></span>
      </button>
      <div id="header-languages" class="nav-dropdown-panel language-dropdown-panel t-dropdown" data-origin="top-right" aria-label={copy.language} aria-hidden="true" hidden inert>
        {languageOptions.map((item) => <a href={languageHref(item.locale)} hreflang={item.locale} lang={item.locale} aria-current={locale === item.locale ? 'page' : undefined}>{item.label}</a>)}
      </div>
    </div>
    <button class="mobile-menu-trigger" type="button" aria-label={copy.openNavigation} aria-expanded="false" aria-controls="mobile-navigation-drawer" data-mobile-menu-trigger data-open-label={copy.openNavigation} data-close-label={copy.closeNavigation}>
      <span class="t-icon-swap" data-state="a" aria-hidden="true">
        <span class="t-icon" data-icon="a"><StaticIcon name="menu" size={25} /></span>
        <span class="t-icon" data-icon="b"><StaticIcon name="close" size={25} /></span>
      </span>
    </button>
  </div>
</header>

<script>
  function initializeHeader(): () => void {
    const controller = new AbortController();
    const { signal } = controller;
    const header = document.querySelector<HTMLElement>('.site-header');
    const body = document.body;
    let mobileFocusTimer: number | undefined;
    const dropdowns = Array.from(header?.querySelectorAll<HTMLElement>('[data-nav-dropdown]') ?? []);
    const dropdownCloseMs = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--dropdown-close-dur')) || 150;
    const dropdownTimers = new Map<HTMLElement, number>();
    const mobileTrigger = header?.querySelector<HTMLButtonElement>('[data-mobile-menu-trigger]');
    const mobileLayer = header?.querySelector<HTMLElement>('[data-mobile-menu-layer]');
    const mobileDrawer = header?.querySelector<HTMLElement>('#mobile-navigation-drawer');
    const mobileBackdrop = header?.querySelector<HTMLButtonElement>('[data-mobile-menu-backdrop]');
    const mobileMedia = window.matchMedia('(max-width: 760px)');

    function closeDropdown(dropdown: HTMLElement, immediately = false) {
      const trigger = dropdown.querySelector<HTMLButtonElement>('.nav-dropdown-trigger');
      const panel = dropdown.querySelector<HTMLElement>('.t-dropdown');
      const timer = dropdownTimers.get(dropdown);
      if (timer) window.clearTimeout(timer);
      dropdown.dataset.open = 'false';
      trigger?.setAttribute('aria-expanded', 'false');
      panel?.setAttribute('aria-hidden', 'true');
      if (panel) panel.inert = true;
      panel?.classList.remove('is-open');
      if (immediately) {
        panel?.classList.remove('is-closing');
        if (panel) panel.hidden = true;
        return;
      }
      panel?.classList.add('is-closing');
      dropdownTimers.set(dropdown, window.setTimeout(() => {
        panel?.classList.remove('is-closing');
        if (panel) panel.hidden = true;
        dropdownTimers.delete(dropdown);
      }, dropdownCloseMs));
    }

    function openDropdown(dropdown: HTMLElement) {
      for (const other of dropdowns) if (other !== dropdown) closeDropdown(other);
      const trigger = dropdown.querySelector<HTMLButtonElement>('.nav-dropdown-trigger');
      const panel = dropdown.querySelector<HTMLElement>('.t-dropdown');
      const timer = dropdownTimers.get(dropdown);
      if (timer) window.clearTimeout(timer);
      if (panel) {
        panel.hidden = false;
        panel.inert = false;
        panel.classList.remove('is-closing');
        void panel.offsetWidth;
        panel.classList.add('is-open');
        panel.setAttribute('aria-hidden', 'false');
      }
      trigger?.setAttribute('aria-expanded', 'true');
      dropdown.dataset.open = 'true';
    }

    for (const dropdown of dropdowns) {
      const trigger = dropdown.querySelector<HTMLButtonElement>('.nav-dropdown-trigger');
      trigger?.addEventListener('click', () => dropdown.dataset.open === 'true' ? closeDropdown(dropdown) : openDropdown(dropdown), { signal });
      trigger?.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
        event.preventDefault();
        openDropdown(dropdown);
        const links = Array.from(dropdown.querySelectorAll<HTMLAnchorElement>('.nav-dropdown-panel a'));
        (event.key === 'ArrowUp' ? links.at(-1) : links[0])?.focus();
      }, { signal });
    }

    function setMobileOpen(open: boolean, restoreFocus = true) {
      if (!mobileLayer || !mobileDrawer || !mobileTrigger) return;
      if (mobileFocusTimer !== undefined) {
        window.clearTimeout(mobileFocusTimer);
        mobileFocusTimer = undefined;
      }
      mobileLayer.dataset.open = String(open);
      mobileDrawer.dataset.open = String(open);
      mobileDrawer.inert = mobileMedia.matches && !open;
      mobileDrawer.setAttribute('aria-hidden', String(mobileMedia.matches && !open));
      mobileTrigger.setAttribute('aria-expanded', String(open));
      mobileTrigger.setAttribute('aria-label', open ? mobileTrigger.dataset.closeLabel || 'Close navigation' : mobileTrigger.dataset.openLabel || 'Open navigation');
      mobileTrigger.querySelector<HTMLElement>('.t-icon-swap')?.setAttribute('data-state', open ? 'b' : 'a');
      body.classList.toggle('nav-drawer-open', open);
      if (open) {
        for (const dropdown of dropdowns) closeDropdown(dropdown, true);
        mobileFocusTimer = window.setTimeout(() => {
          mobileFocusTimer = undefined;
          mobileDrawer.querySelector<HTMLButtonElement>('.nav-dropdown-trigger')?.focus();
        }, 50);
      } else {
        for (const dropdown of dropdowns) if (mobileDrawer.contains(dropdown)) closeDropdown(dropdown, true);
        if (restoreFocus) mobileTrigger.focus();
      }
    }

    mobileTrigger?.addEventListener('click', () => setMobileOpen(mobileTrigger.getAttribute('aria-expanded') !== 'true'), { signal });
    mobileBackdrop?.addEventListener('click', () => setMobileOpen(false), { signal });
    setMobileOpen(false, false);

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node)) return;
      for (const dropdown of dropdowns) if (dropdown.dataset.open === 'true' && !dropdown.contains(event.target)) closeDropdown(dropdown);
    }, { signal });
    header?.addEventListener('focusout', (event) => {
      if (!(event.relatedTarget instanceof Node)) return;
      for (const dropdown of dropdowns) if (dropdown.dataset.open === 'true' && !dropdown.contains(event.relatedTarget)) closeDropdown(dropdown);
    }, { signal });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        const open = [...dropdowns].reverse().find((dropdown) => dropdown.dataset.open === 'true');
        if (open) {
          closeDropdown(open);
          open.querySelector<HTMLButtonElement>('.nav-dropdown-trigger')?.focus();
        } else if (mobileTrigger?.getAttribute('aria-expanded') === 'true') setMobileOpen(false);
        return;
      }
      if (event.key === 'Tab' && mobileTrigger?.getAttribute('aria-expanded') === 'true' && header) {
        const focusable = Array.from(header.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')).filter((element) => element.tabIndex >= 0 && !element.closest('[inert]') && element.getClientRects().length > 0);
        const first = focusable[0];
        const last = focusable.at(-1);
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
      }
    }, { signal });

    mobileMedia.addEventListener('change', () => {
      for (const dropdown of dropdowns) closeDropdown(dropdown, true);
      setMobileOpen(false, false);
    }, { signal });

    return () => {
      controller.abort();
      for (const timer of dropdownTimers.values()) window.clearTimeout(timer);
      if (mobileFocusTimer !== undefined) window.clearTimeout(mobileFocusTimer);
      body.classList.remove('nav-drawer-open');
    };
  }

  let cleanupHeader: (() => void) | undefined;
  function mountHeader() {
    cleanupHeader?.();
    cleanupHeader = initializeHeader();
  }
  function unmountHeader() {
    cleanupHeader?.();
    cleanupHeader = undefined;
  }
  document.addEventListener('astro:page-load', mountHeader);
  document.addEventListener('astro:before-swap', unmountHeader);
  mountHeader();
  if (import.meta.hot) import.meta.hot.dispose(() => {
    unmountHeader();
    document.removeEventListener('astro:page-load', mountHeader);
    document.removeEventListener('astro:before-swap', unmountHeader);
  });
</script>
