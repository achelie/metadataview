---
import { IconGlyph } from './IconGlyph';
import { localizePath, type Locale } from '../i18n/core';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const zh = locale === 'zh-CN';

const privacyBenefits = zh ? [
  { href: '#privacy-checker-workbench', icon: 'shield' as const, eyebrow: '位置检查', title: '把精确位置揪出来', note: '一组 GPS 坐标可能直指门口、学校或住处。报告会显示坐标，以及提供它们的原始字段。', action: '检查一张图片' },
  { href: '#privacy-scan-process', icon: 'scan' as const, eyebrow: '身份检查', title: '顺着面包屑往回找', note: '姓名、序列号、原文件名、时间和编辑 ID，可能把图片连到某个人、设备或项目。', action: '看看检查流程' },
  { href: localizePath('/image-metadata-remover/', locale), icon: 'eraser' as const, eyebrow: '干净点再分享', title: '生成一个清理副本', note: '清除支持的元数据，执行同样深度的复扫，再连同本地验证收据一起下载。', action: '打开清除器' },
] : [
  {
    href: '#privacy-checker-workbench',
    icon: 'shield' as const,
    eyebrow: 'Location check',
    title: 'Catch exact location',
    note: 'A GPS pair can point to a doorway, trail, school, or home. The report shows the coordinates and the fields that supplied them.',
    action: 'Check an image',
  },
  {
    href: '#privacy-scan-process',
    icon: 'scan' as const,
    eyebrow: 'Identity check',
    title: 'Follow the breadcrumbs',
    note: 'Names, serial numbers, original filenames, timestamps, and editing IDs can link an image to a person, device, or project.',
    action: 'See the process',
  },
  {
    href: localizePath('/image-metadata-remover/', locale),
    icon: 'eraser' as const,
    eyebrow: 'Cleaner sharing',
    title: 'Make a cleaner copy',
    note: 'Remove supported metadata, run the same full rescan, and download the new copy with a local verification receipt.',
    action: 'Open remover',
  },
];

const privacyProcess = zh ? [
  { title: '选择一张图片', note: '放入不超过 50 MB 的 JPEG、PNG 或 WebP。文件字节只留在当前标签页。' },
  { title: '验证真实文件', note: '先检查签名、尺寸、动画状态和大小，不会只相信扩展名。' },
  { title: '扫描所有支持的字段', note: '初步结果很快出现，ExifTool WASM 随后检查嵌套记录、预览和内嵌元数据。' },
  { title: '给证据打分', note: 'GPS、姓名、设备 ID、联系方式、时间和编辑痕迹获得可见分数，同一事实不会重复计分。' },
  { title: '清理后再检查', note: '生成本地副本，以相同深度扫描，并在下载前比较已清除、残留和新发现的线索。' },
] : [
  { title: 'Choose one image', note: 'Drop a JPEG, PNG, or WebP up to 50 MB. The bytes stay in this browser tab.' },
  { title: 'Verify the actual file', note: 'The browser checks the signature, dimensions, animation state, and size before trusting the extension.' },
  { title: 'Scan every supported field', note: 'An initial view appears quickly while ExifTool WASM checks nested records, previews, and embedded metadata.' },
  { title: 'Score the evidence', note: 'GPS, names, device IDs, contact details, timestamps, and editing traces earn visible points without double-counting the same fact.' },
  { title: 'Clean and check again', note: 'Create a new local copy, scan it at the same depth, and compare removed, residual, and newly detected clues before download.' },
];
---

<section class="home-benefits privacy-benefits" aria-labelledby="privacy-benefits-title">
  <header class="home-section-heading">
    <span class="section-index">{zh ? '为什么要检查' : 'WHY CHECK IT'}</span>
    <div>
      <h2 id="privacy-benefits-title">{zh ? '为什么要检查图片隐私？' : 'Why check image privacy?'}</h2>
      <p>{zh ? '一张照片可能同时带着地址、姓名和设备痕迹，即使画面里一个字都没写。' : 'One photo can carry an address, a name, and a device trail even when none of that appears in the pixels.'}</p>
    </div>
  </header>
  <div class="home-benefit-grid">
    {privacyBenefits.map((item) => <a href={item.href}>
      <span class="home-benefit-icon"><IconGlyph name={item.icon} size={25} /></span>
      <small>{item.eyebrow}</small>
      <h3>{item.title}</h3>
      <p>{item.note}</p>
      <strong>{item.action} <IconGlyph name="arrow" size={15} /></strong>
    </a>)}
  </div>
</section>

<section id="privacy-scan-process" class="home-process privacy-process" aria-labelledby="privacy-process-title">
  <header>
    <span class="section-index">{zh ? '本机处理，一步一步来' : 'LOCAL, STEP BY STEP'}</span>
    <h2 id="privacy-process-title">{zh ? '隐私检查怎么工作' : 'How the privacy check works'}</h2>
    <p>{zh ? '一张图片，一次自动完整扫描。每一分都能追到元数据证据。' : 'One image. One automatic full scan. Every point links back to metadata evidence.'}</p>
  </header>
  <div class="home-process-body">
    <ol class="home-process-list">
      {privacyProcess.map((step, index) => <li><b>{String(index + 1).padStart(2, '0')}</b><div><h3>{step.title}</h3><p>{step.note}</p></div></li>)}
    </ol>
    <p class="home-process-cta"><span>{zh ? '图片准备好了？' : 'Have an image ready?'}</span><a href="#privacy-checker-workbench">{zh ? '在上面检查图片' : 'Check an image above'} <IconGlyph name="arrow" size={15} /></a></p>
    <details class="format-guide-limitations">
      <summary>{zh ? '这个分数看不到什么' : 'What this score cannot see'}</summary>
      <ul>
        <li>{zh ? '不会分析画面里可见的人脸、文字、屏幕、倒影、车牌、制服和地标。' : 'Faces, text, screens, reflections, plates, uniforms, and landmarks in the visible pixels are not analyzed.'}</li>
        <li>{zh ? '低分只表示受支持的元数据线索较少，不保证图片适合分享。' : 'A low score means fewer supported metadata signals. It does not guarantee that sharing the image is safe.'}</li>
        <li>{zh ? '元数据可以被修改、伪造、留旧或删除，因此不能证明谁创建了图片或图片来自哪里。' : 'Metadata can be edited, forged, stale, or removed, so it cannot prove who created an image or where it came from.'}</li>
      </ul>
    </details>
  </div>
</section>
