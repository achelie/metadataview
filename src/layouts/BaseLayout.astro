---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { canonicalUrl } from '../lib/seo';
import { getAlternatePaths, type Locale } from '../i18n/core';
import { getMessages } from '../i18n/messages';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  schemas?: Record<string, unknown>[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  image?: { src: string; alt: string; width?: number; height?: number };
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  locale?: Locale;
  translated?: boolean;
}

const {
  title,
  description,
  path = '/',
  schemas = [],
  noindex = false,
  ogType = 'website',
  image,
  publishedTime,
  modifiedTime,
  author,
  locale = 'en',
  translated = false,
} = Astro.props;
const canonical = canonicalUrl(path, Astro.site);
const socialImage = image ? new URL(image.src, Astro.site).toString() : undefined;
const copy = getMessages(locale);
const alternatePaths = translated ? getAlternatePaths(path) : undefined;
const alternateUrls = alternatePaths ? Object.fromEntries(Object.entries(alternatePaths).map(([key, value]) => [key, canonicalUrl(value, Astro.site)])) : undefined;
const ogLocales: Record<Locale, string> = { en: 'en_US', de: 'de_DE', 'zh-CN': 'zh_CN' };
const ogLocale = ogLocales[locale];
const alternateOgLocales = translated ? Object.entries(ogLocales).filter(([key]) => key !== locale).map(([, value]) => value) : [];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#171815" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternateUrls && <>
      <link rel="alternate" hreflang="en" href={alternateUrls.en} />
      <link rel="alternate" hreflang="de" href={alternateUrls.de} />
      <link rel="alternate" hreflang="zh-CN" href={alternateUrls['zh-CN']} />
      <link rel="alternate" hreflang="x-default" href={alternateUrls['x-default']} />
    </>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="MetadataView" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {alternateOgLocales.map((alternate) => <meta property="og:locale:alternate" content={alternate} />)}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {image?.alt && <meta property="og:image:alt" content={image.alt} />}
    {image?.width && <meta property="og:image:width" content={String(image.width)} />}
    {image?.height && <meta property="og:image:height" content={String(image.height)} />}
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === 'article' && author && <meta property="article:author" content={author} />}
    {author && <meta name="author" content={author} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {image?.alt && <meta name="twitter:image:alt" content={image.alt} />}
    <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="7tLAA9e0vH5NusPCfeDVgw" async></script>
    {noindex && <meta name="robots" content="noindex" />}
    {schemas.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.skip}</a>
    <Header locale={locale} translated={translated} />
    <main id="main"><slot /></main>
    <Footer locale={locale} />
  </body>
</html>
