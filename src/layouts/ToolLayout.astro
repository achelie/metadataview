---
import BaseLayout from './BaseLayout.astro';
import ToolHero from '../components/ToolHero.astro';
import ToolWorkbench, { type ToolMode } from '../components/ToolWorkbench';
import MetadataReportWorkbench from '../components/MetadataReportWorkbench';
import FormatMetadataGuide from '../components/FormatMetadataGuide.astro';
import ImageMetadataSeo from '../components/ImageMetadataSeo.astro';
import VideoMetadataSeo from '../components/VideoMetadataSeo.astro';
import VideoMetadataRemoverSeo from '../components/VideoMetadataRemoverSeo.astro';
import MetadataRemoverSeo from '../components/MetadataRemoverSeo.astro';
import PrivacyChecker from '../components/privacy/PrivacyChecker';
import MetadataRemovalWorkbench from '../components/MetadataRemovalWorkbench';
import C2paWorkbench from '../components/C2paWorkbench';
import C2paEducation from '../components/C2paEducation.astro';
import PrivacyCheckerSeo from '../components/PrivacyCheckerSeo.astro';
import { IconGlyph, type IconName } from '../components/IconGlyph';
import { canonicalUrl } from '../lib/seo';
import type { FormatGuide } from '../content/tools';
import type { DetectedFileType } from '../lib/metadata/types';
import type { MetadataRemovalScope } from '../lib/metadata-removal/types';
import { localizePath, type Locale } from '../i18n/core';

interface Faq { question: string; answer: string }
interface Related { href: string; title: string; note: string }
interface Props {
  title: string; metaTitle: string; description: string; shortDescription: string; path: string; eyebrow: string; icon: IconName; heroProof?: string;
  mode: ToolMode; formats: string; accept: string; allowedTypes?: DetectedFileType[]; highlights: string[];
  productionMetadataReport?: boolean;
  metadataReportScope?: 'all' | 'image';
  productionPrivacyChecker?: boolean;
  productionMetadataRemover?: boolean;
  metadataRemovalScope?: MetadataRemovalScope;
  productionC2paViewer?: boolean;
  formatGuide?: FormatGuide;
  faqDisplay?: 'accordion' | 'expanded';
  limitations: string[]; faqs: Faq[]; related: Related[];
  locale?: Locale;
}
const props = Astro.props;
const locale = props.locale ?? 'en';
const zh = locale === 'zh-CN';
const de = locale === 'de';
const fr = locale === 'fr';
const t = (en: string, zhText: string, deText: string, frText: string) => zh ? zhText : de ? deText : fr ? frText : en;
const canonical = canonicalUrl(props.path, Astro.site);
const faqDisplay = props.faqDisplay ?? 'accordion';
const isImageSeoPage = locale === 'en' && props.path === '/image-metadata-viewer/';
const isVideoSeoPage = locale === 'en' && props.path === '/video-metadata-viewer/';
const isVideoMetadataRemoverSeoPage = locale === 'en' && props.path === '/video-metadata-remover/';
const isMetadataRemoverSeoPage = locale === 'en' && props.path === '/metadata-remover/';
const visibleFaqs = props.faqs.slice(0, props.productionC2paViewer ? 6 : isImageSeoPage ? 7 : isVideoSeoPage || isVideoMetadataRemoverSeoPage ? 11 : isMetadataRemoverSeoPage ? 9 : faqDisplay === 'expanded' ? 5 : 4);
const schemas = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: props.title, applicationCategory: 'UtilitiesApplication', operatingSystem: t('Any modern browser', '现代浏览器', 'Jeder moderne Browser', 'Tout navigateur moderne'), url: canonical, description: props.description, inLanguage: locale, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, featureList: props.highlights },
  { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: locale, mainEntity: visibleFaqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: t('Home', '首页', 'Startseite', 'Accueil'), item: new URL(localizePath('/', locale), canonical).toString() }, { '@type': 'ListItem', position: 2, name: props.title, item: canonical }] },
];
---
<BaseLayout title={props.metaTitle} description={props.description} path={props.path} schemas={schemas} locale={locale} translated>
  <div class={isVideoSeoPage ? 'page-shell video-metadata-page' : isVideoMetadataRemoverSeoPage ? 'page-shell video-metadata-remover-page' : isMetadataRemoverSeoPage ? 'page-shell metadata-remover-page' : 'page-shell'}>
    <nav class="breadcrumbs" aria-label={t('Breadcrumb', '面包屑导航', 'Brotkrümelnavigation', 'Fil d’Ariane')}><a href={localizePath('/', locale)}>{t('Home', '首页', 'Startseite', 'Accueil')}</a><span>/</span><span>{props.title}</span></nav>
    <ToolHero eyebrow={props.eyebrow} title={props.title} description={props.shortDescription} icon={props.icon} formats={props.formats} proof={props.heroProof} locale={locale} />
    {props.productionMetadataReport ? <MetadataReportWorkbench client:load placement="tool" locale={locale} scope={props.metadataReportScope ?? 'all'} formats={props.formats} accept={props.accept} allowedTypes={props.allowedTypes ?? []} /> : props.productionPrivacyChecker ? <PrivacyChecker client:load locale={locale} /> : props.productionMetadataRemover ? <MetadataRemovalWorkbench client:load locale={locale} scope={props.metadataRemovalScope ?? 'all'} formats={props.formats} accept={props.accept} allowedTypes={props.allowedTypes ?? []} /> : props.productionC2paViewer ? <C2paWorkbench client:load locale={locale} formats={props.formats} accept={props.accept} /> : <ToolWorkbench client:load locale={locale} mode={props.mode} formats={props.formats} accept={props.accept} allowedTypes={props.allowedTypes} />}
    {props.productionC2paViewer ? <C2paEducation locale={locale} faqs={visibleFaqs} /> : <>
      {isImageSeoPage && <ImageMetadataSeo />}
      {isVideoSeoPage && <VideoMetadataSeo />}
      {isVideoMetadataRemoverSeoPage && <VideoMetadataRemoverSeo />}
      {isMetadataRemoverSeoPage && <MetadataRemoverSeo />}
      {props.formatGuide ? <FormatMetadataGuide locale={locale} guide={props.formatGuide} limitations={props.limitations} /> : props.productionPrivacyChecker ? <PrivacyCheckerSeo locale={locale} /> : <section class="tool-notes" aria-labelledby="tool-notes-title">
        <header><span class="section-index">{t('WHAT IT CHECKS', '检查内容', 'WAS ES PRÜFT', 'CE QUI EST VÉRIFIÉ')}</span><h2 id="tool-notes-title">{t('Useful details, without the lecture.', '有用的细节，不上课。', 'Nützliche Details, ohne Vorlesung.', 'Les détails utiles, sans le cours magistral.')}</h2></header>
        <ul class="tool-highlight-list">{props.highlights.map((item) => <li>{item}</li>)}</ul>
        <details class="tool-limitations"><summary>{t('What this result cannot prove', '这个结果不能证明什么', 'Was dieses Ergebnis nicht beweist', 'Ce que ce résultat ne peut pas prouver')}</summary><ul>{props.limitations.map((item) => <li>{item}</li>)}</ul></details>
      </section>}
      {faqDisplay === 'expanded' ? <section class="faq-section expanded-faq" aria-labelledby="tool-faq-title"><div class="expanded-faq-inner"><h2 id="tool-faq-title">{t('Frequently asked questions', '常见问题', 'Häufige Fragen', 'Questions fréquentes')}</h2><div class="expanded-faq-list">{visibleFaqs.map((faq) => <article><h3>{faq.question}</h3><p>{faq.answer}</p></article>)}</div></div></section> : <section class="faq-section"><span class="section-index">FAQ</span><h2>{t('Quick answers', '快速回答', 'Kurze Antworten', 'Réponses rapides')}</h2><div class="faq-list">{visibleFaqs.map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></section>}
      {!props.productionPrivacyChecker && <section class="related-tools"><div><span class="section-index">{t('KEEP GOING', '继续看看', 'WEITERGEHEN', 'POURSUIVRE')}</span><h2>{isImageSeoPage ? 'Related image tools' : isVideoSeoPage || isVideoMetadataRemoverSeoPage ? 'Related video tools' : isMetadataRemoverSeoPage ? 'Metadata removal by file type' : t('Related tools', '相关工具', 'Verwandte Tools', 'Outils associés')}</h2></div><div class="related-list">{props.related.map((item) => <a href={item.href}><strong>{item.title}</strong><span>{item.note}</span><i aria-hidden="true"><IconGlyph name="arrow" size={16} /></i></a>)}</div></section>}
    </>}
  </div>
</BaseLayout>
